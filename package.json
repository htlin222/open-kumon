{
  "name": "open-kumon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "給台灣孩子的日本小學「国語」每日練習單",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:fetch": "tsx scripts/fetch-sources.ts",
    "content:build": "tsx scripts/build-content.ts",
    "content:verify": "tsx scripts/verify-content.ts",
    "audit:sheets": "playwright test tests/audit",
    "content:strokes": "tsx scripts/build-strokes.ts",
    "content:illustrations": "tsx scripts/build-illustrations.ts",
    "content:all": "pnpm content:build && pnpm content:strokes && pnpm content:illustrations && pnpm content:verify"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@fontsource/klee-one": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@primer/react": "^38.34.0",
    "@tabler/icons-react": "^3.46.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "japanese": "^1.2.0",
    "jsdom": "^30.0.1",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "openmoji": "^17.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@10.13.1"
}
